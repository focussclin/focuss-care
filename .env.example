# =============================================================================
# Focuss Care — variaveis de ambiente
#
# Copie para .env.local e preencha. NUNCA versione o .env.local nem cole
# chaves reais neste arquivo de exemplo.
# =============================================================================

# --- Supabase ---------------------------------------------------------------
# Sem URL + chave publica, a aplicacao roda em modo de demonstracao, com os dados
# de src/lib/mocks/clinic-data.ts. Nenhuma tela quebra; nada toca o banco.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ⚠️ IGNORA RLS — acesso total a todas as clinicas.
# Somente no servidor (jobs, webhooks, onboarding). Sem prefixo NEXT_PUBLIC_,
# para que o Next jamais a inclua no bundle do browser.
SUPABASE_SECRET_KEY=

# O Supabase Auth e a UNICA fonte de autenticacao do projeto.
# As variaveis FOCUSS_ADMIN_* foram removidas junto com o login local legado
# (src/lib/auth/local-admin.ts); podem ser apagadas do seu .env.local.
